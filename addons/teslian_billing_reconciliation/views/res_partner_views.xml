<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record
        id="view_partner_form_teslian_billing"
        model="ir.ui.view"
    >

        <field name="name">
            res.partner.form.teslian.billing
        </field>

        <field name="model">
            res.partner
        </field>

        <field
            name="inherit_id"
            ref="base.view_partner_form"
        />

        <field name="arch" type="xml">

            <xpath
                expr="//notebook"
                position="inside"
            >

                <page string="TESLIAN / RED GPS">

                    <group>
                        <group string="Integración RED GPS">

                            <field name="redgps_client_id"/>

                            <field
                                name="teslian_billing_status"
                                widget="statusbar"
                                statusbar_visible="not_checked,matched,review,error"
                            />

                            <field
                                name="teslian_last_reconciliation"
                                readonly="1"
                            />

                        </group>

                        <group string="Facturación">

                            <field
                                name="teslian_can_invoice"
                                readonly="1"
                            />

                            <field
                                name="teslian_odoo_asset_count"
                                readonly="1"
                            />

                            <field
                                name="teslian_redgps_asset_count"
                                readonly="1"
                            />

                            <field
                                name="teslian_reconciliation_difference"
                                readonly="1"
                            />

                        </group>
                    </group>


                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="teslian_billing_status != 'review'"
                    >
                        <strong>
                            Facturación bloqueada.
                        </strong>

                        Se detectaron diferencias entre Odoo y RED GPS.
                        El cliente requiere revisión manual antes de facturar.
                    </div>


                    <div
                        class="alert alert-success"
                        role="alert"
                        invisible="teslian_billing_status != 'matched'"
                    >
                        <strong>
                            Conciliación correcta.
                        </strong>

                        La información coincide con RED GPS.
                        El cliente está habilitado para facturación.
                    </div>


                    <group string="Acciones">

                        <button
                            name="action_teslian_reconcile"
                            type="object"
                            tring="Validar con RED GPS"
                            class="btn-primary"
                        />

                    </group>


                    <group string="Resultado de conciliación">

                        <field
                            name="teslian_reconciliation_message"
                            readonly="1"
                        />

                        <field
                            name="teslian_missing_in_redgps"
                            readonly="1"
                            invisible="not teslian_missing_in_redgps"
                        />

                        <field
                            name="teslian_missing_in_odoo"
                            readonly="1"
                            invisible="not teslian_missing_in_odoo"
                        />

                    </group>


                    <separator string="Activos operativos"/>

                    <field name="teslian_asset_ids">

                        <list editable="bottom">

                            <field name="name"/>

                            <field name="redgps_asset_id"/>

                            <field name="imei"/>

                            <field name="plate"/>

                            <field name="operational"/>

                            <field
                                name="last_reconciliation_status"
                                readonly="1"
                            />

                        </list>

                    </field>

                </page>
            </xpath>

        </field>

    </record>

</odoo>