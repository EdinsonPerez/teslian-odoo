<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record
        id="view_move_form_teslian_reconciliation"
        model="ir.ui.view"
    >

        <field name="name">
            account.move.form.teslian.reconciliation
        </field>

        <field name="model">
            account.move
        </field>

        <field
            name="inherit_id"
            ref="account.view_move_form"
        />

        <field name="arch" type="xml">

            <xpath
                expr="//notebook"
                position="inside"
            >

                <page
                    string="TESLIAN"
                    invisible="not teslian_redgps_client_id"
                >

                    <group>

                        <group string="Conciliación">

                            <field
                                name="teslian_reconciliation_status"
                                readonly="1"
                            />

                            <field
                                name="teslian_reconciliation_date"
                                readonly="1"
                            />

                            <field
                                name="teslian_redgps_client_id"
                                readonly="1"
                            />

                        </group>


                        <group string="Activos validados">

                            <field
                                name="teslian_odoo_asset_count"
                                readonly="1"
                            />

                            <field
                                name="teslian_redgps_asset_count"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <group string="Resultado">

                        <field
                            name="teslian_reconciliation_message"
                            readonly="1"
                        />

                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>